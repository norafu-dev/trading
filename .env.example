# Copy to .env (chmod 600). Never commit .env.
# Use a URL safe password (letters and digits), e.g. `openssl rand -hex 24`:
# DATABASE_URL is assembled from these three values.
POSTGRES_USER=harvester
POSTGRES_PASSWORD=change-me
POSTGRES_DB=harvester

# Required by api and collector. Encrypts the TOTP secret and Discord tokens (format: spec 0004).
# Generate with: cd backend && uv run python -m harvester.crypto genkey
# Back it up separately: losing it makes the stored secrets undecryptable.
TOKEN_ENCRYPTION_KEY=
# Optional, only while rotating: comma separated old keys, each in the same <version>:<base64> format.
TOKEN_ENCRYPTION_OLD_KEYS=

# Local dev values. In production compose derives SITE_ORIGIN from SITE_DOMAIN; leave the cookie secure.
SITE_ORIGIN=http://localhost:8080
SESSION_COOKIE_SECURE=false

LOG_LEVEL=INFO
# Optional, local only: also write <LOG_DIR>/collector.log and <LOG_DIR>/api.log (rotated, about 60 MB per process).
# A relative path starts from where you run the process, so `logs` means backend/logs. Leave unset in production.
# LOG_DIR=logs

# Production only
SITE_DOMAIN=dashboard.example.com
# Images are <IMAGE_PREFIX>-backend and <IMAGE_PREFIX>-caddy
IMAGE_PREFIX=ghcr.io/<github-owner>/harvester
