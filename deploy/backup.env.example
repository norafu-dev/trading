# 复制成 ~/harvester/backup.env（chmod 600）再填值。永远不要提交真实的 backup.env。
# 只有 backup.sh 会读它，不放进 .env，容器读不到这些密钥。

# Cloudflare 账号 ID（R2 地址 https://<ID>.r2.cloudflarestorage.com 用）
R2_ACCOUNT_ID=

# 服务器专用的 R2 API token：只限备份桶，权限「对象读写」
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# 备份桶名，比如 harvester-backups
R2_BUCKET=

# age 公钥（age1... 开头）。私钥只放密码管理器，不要放到服务器上
BACKUP_AGE_RECIPIENT=
