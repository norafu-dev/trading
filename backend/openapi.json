  "components": {
    "schemas": {
      "AccountCreate": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Label"
          },
          "token": {
            "type": "string",
            "format": "password",
            "title": "Token",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "label",
          "token"
        ],
        "title": "AccountCreate"
      },
      "AccountEnvelope": {
        "properties": {
          "account": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/DiscordAccountOut"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "account"
        ],
        "title": "AccountEnvelope"
      },
      "AuthState": {
        "properties": {
          "state": {
            "type": "string",
            "enum": [
              "setup_required",
              "unauthenticated",
              "authenticated"
            ],
            "title": "State"
          }
        },
        "type": "object",
        "required": [
          "state"
        ],
        "title": "AuthState"
      },
      "ChannelOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "guild_id": {
            "type": "string",
            "title": "Guild Id"
          },
          "parent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Id"
          },
          "type": {
            "type": "integer",
            "title": "Type"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "archived",
              "deleted"
            ],
            "title": "Status"
          },
          "collect_enabled": {
            "type": "boolean",
            "title": "Collect Enabled"
          },
          "collectable": {
            "type": "boolean",
            "title": "Collectable"
          },
          "can_read": {
            "type": "boolean",
            "title": "Can Read"
          }
        },
        "type": "object",
        "required": [
          "id",
          "guild_id",
          "parent_id",
          "type",
          "name",
          "position",
          "status",
          "collect_enabled",
          "collectable",
          "can_read"
        ],
        "title": "ChannelOut"
      },
      "ChannelsOut": {
        "properties": {
          "channels": {
            "items": {
              "$ref": "#/components/schemas/ChannelOut"
            },
            "type": "array",
            "title": "Channels"
          }
        },
        "type": "object",
        "required": [
          "channels"
        ],
        "title": "ChannelsOut"
      },
      "CollectBody": {
        "properties": {
          "enabled": {
            "type": "boolean",
            "title": "Enabled"
          }
        },
        "type": "object",
        "required": [
          "enabled"
        ],
        "title": "CollectBody"
      },
      "DiscordAccountOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "discord_user_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Discord User Id"
          },
          "discord_username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Discord Username"
          },
          "status": {
            "type": "string",
            "enum": [
              "connecting",
              "online",
              "reconnecting",
              "token_invalid",
              "banned",
              "disabled",
              "verification_required",
              "login_paused",
              "account_mismatch"
            ],
            "title": "Status"
          },
          "status_changed_at": {
            "type": "string",
            "format": "date-time",
            "title": "Status Changed At"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "last_heartbeat_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Heartbeat At"
          },
          "retry_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retry At"
          },
          "collector_stale": {
            "type": "boolean",
            "title": "Collector Stale"
          }
        },
        "type": "object",
        "required": [
          "id",
          "label",
          "discord_user_id",
          "discord_username",
          "status",
          "status_changed_at",
          "last_error",
          "last_heartbeat_at",
          "retry_at",
          "collector_stale"
        ],
        "title": "DiscordAccountOut"
      },
      "GuildOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "icon_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Icon Hash"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "left",
              "deleted"
            ],
            "title": "Status"
          },
          "enabled_count": {
            "type": "integer",
            "title": "Enabled Count"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "icon_hash",
          "status",
          "enabled_count"
        ],
        "title": "GuildOut"
      },
      "GuildsOut": {
        "properties": {
          "synced_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Synced At"
          },
          "guilds": {
            "items": {
              "$ref": "#/components/schemas/GuildOut"
            },
            "type": "array",
            "title": "Guilds"
          }
        },
        "type": "object",
        "required": [
          "synced_at",
          "guilds"
        ],
        "title": "GuildsOut"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "string",
            "enum": [
              "ok",
              "unreachable"
            ],
            "title": "Database"
          },
          "database_time": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Database Time"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "Health"
      },
      "LabelUpdate": {
        "properties": {
          "label": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "label"
        ],
        "title": "LabelUpdate"
      },
      "Liveness": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Liveness"
      },
      "LoginBody": {
        "properties": {
          "password": {
            "type": "string",
            "title": "Password"
          },
          "totp_code": {
            "type": "string",
            "maxLength": 32,
            "title": "Totp Code"
          }
        },
        "type": "object",
        "required": [
          "password",
          "totp_code"
        ],
        "title": "LoginBody"
      },
      "LoginEventOut": {
        "properties": {
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "title": "Occurred At"
          },
          "ip": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ip"
          },
          "user_agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Agent"
          },
