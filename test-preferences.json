{
  "tool": "pytest",
  "gate": null,
  "additionalTools": ["pytest-asyncio"],
  "e2eTool": "none",
  "testDir": "backend/tests",
  "filePattern": "test_*.py",
  "packageManager": "uv",
  "packages": {
    "web": {
      "tool": "vitest",
      "additionalTools": ["@testing-library/react", "@testing-library/user-event", "@testing-library/jest-dom", "jsdom"],
      "e2eTool": "none",
      "testDir": "beside source",
      "filePattern": "*.test.ts(x)",
      "packageManager": "pnpm"
    }
  }
}
